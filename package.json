{
  "name": "rocky-desktop",
  "version": "1.0.0",
  "description": "Rocky - an AI desktop companion powered by a local LLM (Ollama) with physics, animation, and voice.",
  "author": "adam1xz",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:electron": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite --port=3000\" \"npm run start:electron\"",
    "start:electron": "tsc -p tsconfig.electron.json && cross-env DEV=true electron .",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-installer-assets": "node installer/generate-installer-assets.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.2"
  },
  "build": {
    "appId": "com.rocky.desktop",
    "productName": "Rocky",
    "icon": "public/icon.png",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
